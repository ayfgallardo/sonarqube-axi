{
  "name": "sonarqube-axi",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.1.1",
  "description": "AXI-compliant SonarQube CLI — token-efficient TOON output, contextual suggestions, targeted mutations. Built on the glab-axi architecture.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/ayfgallardo/sonarqube-axi.git"
  },
  "keywords": [
    "sonarqube",
    "cli",
    "agent",
    "axi",
    "toon"
  ],
  "bin": {
    "sonarqube-axi": "./dist/bin/sonarqube-axi.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "tsx bin/sonarqube-axi.ts",
    "prepare": "npm run build"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@toon-format/toon": "^4.1.1",
    "axi-sdk-js": "^0.1.11",
    "undici": "^8.10.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.4.0",
    "eslint": "^10.9.1",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11"
  }
}
